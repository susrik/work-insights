    "repo_url_template": "https://github.com/example/notes/blob/main/{path}"
  },
  "jobs": {
    "schedules": {},
    "log_retention_days": 30,
    "log_prompt_preview_chars": 600
  },
  "discord": { "enabled": false },
  "google": { "enabled": false }
}
